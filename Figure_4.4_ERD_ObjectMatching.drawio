        <mxCell id="note1" value="The background agent compares each lost_items.embedding against every unresolved found_items.embedding. There is no foreign key between them: the relationship is established at run time by the 1,536-value descriptor comparison." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="810" y="540" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note2" value="security_question is written by the Secure Handover Module (project partner). That module's claims, claim_messages and claim_handovers tables reference found_items.id and are outside the scope of this module." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;verticalAlign=top;fontColor=#808080;" vertex="1" parent="1">
          <mxGeometry x="810" y="40" width="290" height="110" as="geometry" />
